%%writefile app.py
import streamlit as st
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import koreanize_matplotlib

# 페이지 제목 및 레이아웃
st.set_page_config(page_title="KGC 스마트팩토리 예지보전", layout="wide")

@st.cache_data
def load_data():
    # NASA CMAPSS 데이터 로드
    url = "https://raw.githubusercontent.com/jiminxchris/datas/main/CMAPSSData/train_FD001.txt"
    raw_cols = ['id', 'cycle', 'setting1', 'setting2', 'setting3'] + [f's{i}' for i in range(1, 22)]
    df = pd.read_csv(url, sep=r'\s+', header=None, names=raw_cols)
    
    # KGC 공정 명칭 매핑
    kgc_map = {
        'id': '설비_ID', 'cycle': '가동_사이클',
        's2': '증삼기_내부온도', 's3': '추출기_상단온도', 
        's4': '건조기_출구온도', 's7': '이송펌프_회전속도', 
        's11': '냉각수_공급압력', 's12': '가열히터_전류값'
    }
    return df[list(kgc_map.keys())].rename(columns=kgc_map)

# 데이터 준비
data = load_data()

# [사이드바] 설비 선택
st.sidebar.header("🏭 설비 모니터링")
unit_id = st.sidebar.selectbox("대상 설비 번호", data['설비_ID'].unique())
unit_df = data[data['설비_ID'] == unit_id]

# [메인 화면]
st.title("🍄 KGC 인삼 공정 예지보전 시스템")
st.info(f"현재 {unit_id}번 설비의 가동 상태를 분석 중입니다.")

# 대시보드 지표 (Metrics)
m1, m2, m3 = st.columns(3)
with m1:
    st.metric("현재 사이클", f"{unit_df['가동_사이클'].max()}회")
with m2:
    st.metric("증삼기 평균온도", f"{unit_df['증삼기_내부온도'].mean():.1f}°C")
with m3:
    st.metric("냉각수 공급압력", f"{unit_df['냉각수_공급압력'].mean():.2f} psi")

# 시각화 탭
tab1, tab2 = st.tabs(["센서 데이터 추이", "고장 징후 분석"])

with tab1:
    st.subheader("실시간 공정 센서 로그")
    selected_sensor = st.selectbox("확인할 센서 선택", ['증삼기_내부온도', '추출기_상단온도', '건조기_출구온도'])
    
    fig, ax = plt.subplots(figsize=(10, 4))
    ax.plot(unit_df['가동_사이클'], unit_df[selected_sensor], color='firebrick', lw=1.5)
    ax.set_title(f"{unit_id}번 설비 - {selected_sensor} 변화")
    ax.set_xlabel("가동 시간(Cycle)")
    ax.set_ylabel("수치")
    st.pyplot(fig)

with tab2:
    st.subheader("AI 기반 이상 징후 판단")
    # 상관관계 히트맵 예시
    corr = unit_df.corr()
    fig2, ax2 = plt.subplots(figsize=(8, 6))
    sns.heatmap(corr, annot=True, cmap='RdYlGn', ax=ax2)
    st.pyplot(fig2)
